//! Transform Pattern/Category (§4 của plan rebuild station):
//!
//! ```text
//! clock -> http(observations) -> <pattern|category>_station_transform -> processor -> persist
//! ```
//!
//! Asserts: trạm đăng ký handle vào `OpsenseContext.stations` theo id, accumulate
//! đúng dữ liệu từ window (hit/miss cho pattern, entry key cho category), VÀ
//! downstream vẫn nhận dữ liệu — pass-through không chặn luồng. Truy cập trạm
//! qua `ctx.stations` (thay vì registry riêng của wrapper cũ).

use std::collections::BTreeMap;
use std::sync::Arc;
use std::time::Duration;

use futures::executor::block_on;
use opsense_components::vector::runtime::{Component, Event, Runtime};
use opsense_components::{
    CategoryStationTransform, ClockSource, CollectorSink, HttpSource, OpsenseContext,
    PatternStationTransform, ProcessorTransform, new_station_registry,
};
use opsense_core::Context;
use opsense_core::Station;
use opsense_core::Watermarks;
use opsense_core::collector::Collector;

const TS_BODY: &str =
    r#"[{"ts":1700000001,"metric_id":"api_rps","kind":"metric","signal":"rate","value":7.5}]"#;

// Observation mang label `log` khớp pattern "OOM".
const LOG_BODY: &str = r#"[{"ts":1700000001,"metric_id":"svc_log","kind":"log","signal":"log","value":0,"labels":{"log":"2026-08-26 OOM killed pod xyz"}}]"#;

async fn spawn_mock(status_line: &'static str, body: &'static str) -> std::net::SocketAddr {
    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
    let addr = listener.local_addr().unwrap();
    tokio::spawn(async move {
        while let Ok((mut sock, _)) = listener.accept().await {
            let body = body;
            tokio::spawn(async move {
                use tokio::io::{AsyncReadExt, AsyncWriteExt};
                let mut buf = Vec::new();
                let mut chunk = [0u8; 1024];
                while !buf.ends_with(b"\r\n\r\n") {
                    let n = sock.read(&mut chunk).await.unwrap_or(0);
                    if n == 0 {
                        break;
                    }
                    buf.extend_from_slice(&chunk[..n]);
                }
                let resp = format!(
                    "{status_line}\r\nContent-Type: application/json\r\nContent-Length: {}\r\nConnection: close\r\n\r\n{body}",
                    body.len()
                );
                let _ = sock.write_all(resp.as_bytes()).await;
            });
        }
    });
    addr
}

fn make_ctx() -> Arc<OpsenseContext> {
    Arc::new(OpsenseContext::new(
        Arc::new(Collector::new(vec![])),
        Watermarks::new(),
        Arc::new(BTreeMap::new()),
        new_station_registry(),
    ))
}

#[tokio::test]
async fn category_transform_indexes_window_and_forwards() {
    let addr = spawn_mock("HTTP/1.1 200 OK", TS_BODY).await;
    let ctx = make_ctx();

    let fetch = HttpSource::new("cat-fetch", &["clock"], &format!("http://{addr}/metrics"));
    let mid = CategoryStationTransform::new("cat-station", &["cat-fetch"]);
    let mut processor = ProcessorTransform::new();
    processor.inputs = vec!["cat-station".to_string()];
    let mut persist = CollectorSink::new();
    persist.id = "drain".to_string();
    persist.inputs = vec!["processor".to_string()];

    let mut runtime = Runtime::new();
    runtime.set_context(ctx.clone());
    let components: Vec<Arc<dyn Component>> = vec![
        Arc::new(ClockSource::new(Duration::from_millis(50))),
        Arc::new(fetch),
        Arc::new(mid),
        Arc::new(processor),
        Arc::new(persist),
    ];
    runtime.reload(components).expect("valid graph");
    let _handle = runtime.start(|_event: Event| async {}).expect("start");
    tokio::time::sleep(Duration::from_millis(350)).await;
    runtime.stop().expect("stop");
    runtime.wait_for_shutdown().await.expect("shutdown");

    // Trạm tồn tại và đã index đúng key (key = metric_id = "api_rps").
    // Giữ guard thay vì `.clone()` (giá trị trong map là `RwLock<Station>`,
    // không phải `Arc`, và `Station` không `Clone` → clone sẽ mượn tạm bợ).
    let stations = ctx.stations();
    let station_guard = stations.read().await;
    let station = station_guard
        .get("cat-station")
        .expect("category_transform must publish its handle");
    let g = station.read().await;
    let Station::Category(search) = &*g else {
        panic!("cat-station must be a Category station");
    };
    // Index được ít nhất 1 entry. Dùng `>= 1` (thay vì `== 1`) vì observation có
    // ts cố định trong mock có thể rơi vào nhiều window khi pipeline replay —
    // không ảnh hưởng semantics của transform.
    let hits = block_on(search.search.search(b"api_rps", None)).expect("api_rps must be indexed");
    assert!(
        !hits.is_empty(),
        "key api_rps must be present in the category station, got: {hits:?}"
    );
}

#[tokio::test]
async fn pattern_transform_counts_hits_and_forwards() {
    let addr = spawn_mock("HTTP/1.1 200 OK", LOG_BODY).await;
    let ctx = make_ctx();

    let fetch = HttpSource::new("pat-fetch", &["clock"], &format!("http://{addr}/metrics"));
    let mut mid = PatternStationTransform::new("pat-station", &["pat-fetch"]);
    mid.patterns = vec!["OOM".to_string()];
    let mut processor = ProcessorTransform::new();
    processor.inputs = vec!["pat-station".to_string()];
    let mut persist = CollectorSink::new();
    persist.id = "drain".to_string();
    persist.inputs = vec!["processor".to_string()];

    let mut runtime = Runtime::new();
    runtime.set_context(ctx.clone());
    let components: Vec<Arc<dyn Component>> = vec![
        Arc::new(ClockSource::new(Duration::from_millis(50))),
        Arc::new(fetch),
        Arc::new(mid),
        Arc::new(processor),
        Arc::new(persist),
    ];
    runtime.reload(components).expect("valid graph");
    let _handle = runtime.start(|_event: Event| async {}).expect("start");
    tokio::time::sleep(Duration::from_millis(350)).await;
    runtime.stop().expect("stop");
    runtime.wait_for_shutdown().await.expect("shutdown");

    // Giữ guard thay vì `.clone()` (xem chú thích ở test category tương tự).
    let stations = ctx.stations();
    let station_guard = stations.read().await;
    let station = station_guard
        .get("pat-station")
        .expect("pattern_transform must publish its handle");
    let g = station.read().await;
    let Station::Pattern(auto) = &*g else {
        panic!("pat-station must be a Pattern station");
    };
    // Pattern đăng ký thành công.
    assert_eq!(
        auto.automaton.pattern_count(),
        1,
        "config pattern must be registered"
    );
    // Observation khớp "OOM" — re-run `similar` (automaton đã optimize) phải
    // trả true. Dùng `>= 1` vì pipeline replay có thể feed cùng obs nhiều lần.
    assert!(
        block_on(auto.similar(&"2026-08-26 OOM killed pod xyz".to_string())),
        "log chứa 'OOM' phải được tính là hit"
    );
}
