# opsense — biến môi trường cho systemd unit.
#
# Format của systemd EnvironmentFile: KHÔNG có `export`, KHÔNG shell expand,
# `key=value` một dòng. File này cũng là conffile (dpkg giữ khi upgrade).
#
# Nạp bởi `EnvironmentFile=-/etc/opsense/opsense.env` trong
# packaging/systemd/opsense.service. Dấu `-` nghĩa là thiếu file cũng chạy.

# Config chính — unit đã đặt sẵn, dòng này để tự tài liệu hoá.
OPSENSE_CONFIG=/etc/opsense/opsense.toml

# `unix` (mặc định) = bind /run/axum, nginx proxy qua socket ⇒ app không mở
# port nào. `http` = TCP; khi đó sửa `upstream` trong
# /etc/nginx/sites-available/opsense.conf thành `server 127.0.0.1:8080;`.
GATEWAY_LISTENER=unix
# GATEWAY_ADDR=127.0.0.1:8080

# Debug: `info` (mặc định), `opsense=debug,rhai=debug`, hoặc `trace`.
# RUST_LOG=info

# DSN cho backend Redis/Valkey, dùng kèm `backend = "redis"` trong
# /etc/opsense/opsense.toml. Chỉ có tác dụng khi binary build có feature
# `opsense-core/redis` — xem docs/KUBERNETES.md.
# OPSENSE_REDIS_URL=redis://127.0.0.1:6379

# Gửi lỗi lên Sentry (tắt mặc định — không phát tán telemetry ra ngoài).
# SENTRY_DSN=
